@model List<LoanView>

@{
    ViewData["Title"] = "Loans";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>📚 Library Loans</h1>
        <p class="text-muted mb-0">Manage borrowed and returned books.</p>
    </div>

    <a asp-action="Borrow" class="btn btn-primary">
        + Borrow a Book
    </a>
</div>

<div class="summary-card">
    <h3>@Model.Count</h3>
    <span class="text-muted">Total loan records</span>
</div>

<div class="library-card">
    <h5 class="mb-3">Loan Records</h5>

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Member</th>
                    <th>Book</th>
                    <th>Loaned Date</th>
                    <th>Due Date</th>
                    <th>Status</th>
                    <th class="text-end">Action</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var loan in Model)
                {
                    <tr>
                        <td><strong>@loan.MemberName</strong></td>

                        <td>@loan.BookTitle</td>

                        <td>@loan.LoanedOn.ToString("yyyy-MM-dd")</td>

                        <td>@loan.LoanedOn.AddDays(loan.DaysAllowed).ToString("yyyy-MM-dd")</td>

                        <td>
                            <span class="status-badge @(loan.Status == "Overdue" ? "status-overdue" : loan.Status == "Out" ? "status-out" : "status-returned")">
                                @loan.Status
                            </span>
                        </td>

                        <td class="text-end">
                            @if (loan.ReturnedOn == null)
                            {
                                <form asp-action="Return"
                                      asp-route-id="@loan.LoanId"
                                      method="post">

                                    <button type="submit"
                                            class="btn btn-sm btn-outline-success">
                                        ✓ Return
                                    </button>
                                </form>
                            }
                            else
                            {
                                <span class="text-muted">Completed</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>