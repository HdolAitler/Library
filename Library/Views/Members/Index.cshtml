@* Redesigned Member List: Table replaced with a clean, responsive Bootstrap Card Grid *@
<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
    @foreach (var member in Model)
    {
        <div class="col">
            <div class="card h-100 shadow-sm border-start border-primary border-4">
                <div class="card-body d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <h5 class="card-title text-dark fw-bold mb-0">@member.FullName</h5>
                        <span class="badge @(member.MemberType == "Faculty" ? "text-bg-warning" : member.MemberType == "Student" ? "text-bg-info" : "text-bg-secondary")">
                            @member.MemberType
                        </span>
                    </div>

                    <h6 class="card-subtitle mb-3 text-muted small">
                        Member ID: #@member.MemberId
                    </h6>

                    <p class="card-text mb-4 text-truncate">
                        <strong>Email:</strong>
                        <span class="@(member.Email == null ? "text-muted italic" : "")">
                            @(member.Email ?? "—")
                        </span>
                    </p>

                    <!-- Action buttons anchored beautifully at the bottom of the card -->
                    <div class="mt-auto d-flex gap-2 justify-content-end border-top pt-3">
                        <a asp-action="Edit" asp-route-id="@member.MemberId" class="btn btn-sm btn-outline-secondary px-3">
                            Edit
                        </a>
                        <a asp-action="Delete" asp-route-id="@member.MemberId" class="btn btn-sm btn-outline-danger px-3">
                            Delete
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

